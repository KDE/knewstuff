#: core/installation.cpp:101
#, kde-format
msgid "Invalid item."
msgstr "Loša stavka."

#: core/installation.cpp:108
#, kde-format
msgid "Download of item failed: no download URL for \"%1\"."
msgstr "Neuspjelo preuzimanje stavke: nema URL‑a za preuzimanje za „%1“."

